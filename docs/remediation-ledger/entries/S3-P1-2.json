    "test": "a_link_that_dies_before_the_peer_acknowledges_leaves_a_pending_note_not_trust",
    "command": "cargo test --locked --manifest-path shared/rust-core/Cargo.toml",
    "asserts": "\u88ab\u5ba1\u8ba1\u7684\u5411\u91cf\u672c\u8eab\uff1a\u53cc\u65b9\u7528\u6237\u90fd\u786e\u8ba4\u540e\u672c\u7aef\u5199\u5165\u6ce8\u8bb0\u5e76\u53d1\u51fa PairingPersisted\uff0c\u5bf9\u7aef\u59cb\u7ec8\u672a\u53d1\u51fa\u6301\u4e45\u5316\u786e\u8ba4\uff08PairingPersisted\uff09\uff0c\u968f\u540e\u94fe\u8def\u65ad\u5f00\u3002\u65ad\u8a00\u2460phase != Paired\uff08\u672a\u786e\u8ba4\u7684\u914d\u5bf9\u4e0d\u5f97\u62a5\u544a\u4e3a\u5b8c\u6210\uff09\uff1b\u2461trusted_peer_keys \u4e2d\u6ca1\u6709\u8be5\u8bbe\u5907\u2014\u2014\u8fd9\u662f**\u552f\u4e00**\u7684\u4fe1\u4efb\u4e8b\u5b9e\u6e90\uff0cpeer_is_allowed\u3001\u8fde\u63a5\u6c60\u3001peer \u76ee\u5f55\u4e0e\u4e24\u7aef UI \u90fd\u8bfb\u5b83\uff0c\u6240\u4ee5\"\u4e0d\u628a pending \u8868\u793a\u4e3a\u5df2\u914d\u5bf9\"\u4e0d\u9700\u8981\u4efb\u4f55 UI \u6539\u52a8\uff1b\u2462\u6ce8\u8bb0\u88ab\u8bb0\u5f55\u4e14\u5176 public_key \u7b49\u4e8e\u5bf9\u7aef\u5bc6\u94a5\u3002\u540c\u6587\u4ef6\u53e6\u6709 13 \u4e2a\u6d4b\u8bd5\u8986\u76d6\u5176\u4f59\u8fb9\u754c\uff08\u542b the_settings_shape_stays_readable_by_an_older_build\uff09\uff1a\u5bf9\u7aef\u786e\u8ba4\u4e4b\u524d\u7684\u65ad\u5f00\u4e0d\u8bb0\u5f55\u4efb\u4f55\u4e1c\u897f\u3001\u4f1a\u8bdd\u8d85\u65f6\u540e\u6ce8\u8bb0\u4fdd\u7559\u3001\u91cd\u590d\u786e\u8ba4\u5e42\u7b49\u4e14\u4e0d\u6388\u4e88\u4fe1\u4efb\u3001\u5b8c\u6210\u540e\u6070\u597d\u4e00\u6761 active \u8bb0\u5f55\u4e14\u6ce8\u8bb0\u6e05\u9664\u3001\u91cd\u542f\u540e\u6ce8\u8bb0\u4ecd\u5728\u4e14\u4ecd\u4e3a\u672a\u914d\u5bf9\u3001\u53d6\u6d88\u5148\u4e8e ack \u65f6\u4e0d\u5199\u4fe1\u4efb\u3001\u53d6\u6d88\u65e0\u6cd5\u63d2\u5165\"\u68c0\u67e5\u4e0e\u5199\u4fe1\u4efb\u4e4b\u95f4\"\u7684\u7a97\u53e3\u3001forget_pending \u540c\u65f6\u6e05\u9664\u5185\u5b58\u4e0e\u78c1\u76d8\u3001\u51bb\u7ed3\u7684\u65e7\u7248 config-v2.json \u4ecd\u53ef\u52a0\u8f7d\u4e14\u65e2\u6709\u4fe1\u4efb\u4e0d\u53d8\u3001\u65e7\u7aef\u2192\u65b0\u7248\u4e0e\u65b0\u7248\u2192\u65e7\u7aef\uff08\u672c\u7aef\u4e3a\u53d1\u8d77\u65b9\uff09\u4e24\u4e2a\u65b9\u5411\u90fd\u80fd\u5b8c\u6210\u3001\u4ee5\u53ca\u65e7\u7aef\u53ea\u5728\u672c\u7aef\u6ce8\u8bb0\u843d\u76d8\u540e\u624d\u4f1a\u6536\u5230\u6301\u4e45\u5316\u5e27\uff08\u8be5\u987a\u5e8f\u662f\u4e92\u901a\u5b89\u5168\u6027\u7684\u4f9d\u636e\uff09\u3002\u53d8\u5f02\u9a8c\u8bc1\uff08\u5747\u5b9e\u6d4b\uff0c\u5171 14 \u4e2a\u6d4b\u8bd5\uff09\uff1a\u628a record_pending_pairing \u6539\u56de\"\u672c\u5730\u786e\u8ba4\u5373\u5199 trust\"\u2192 6 \u4e2a\u5931\u8d25\uff1b\u628a\u6ce8\u8bb0\u5199\u5165\u6574\u4e2a\u53bb\u6389 \u2192 7 \u4e2a\u5931\u8d25\uff1b\u628a promote_pairing \u6539\u56de\"\u68c0\u67e5\u540e\u91ca\u653e\u72b6\u6001\u9501\"\u2192 \u7a97\u53e3\u6d4b\u8bd5 1 \u4e2a\u5931\u8d25\u3002"
  },
