    "title": "连接状态订阅",
    "description": "async fn watch_runtime(mut events: Receiver<Snapshot>)",
    "body": "async fn watch_runtime(\n    mut events: Receiver<Snapshot>,\n) -> Result<()> {\n    while let Some(snapshot) = events.recv().await {\n        let state = snapshot.connection_state();\n        runtime.publish(state).await?;\n    }\n    Ok(())\n}",
