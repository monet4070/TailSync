<local:MacWindow x:Class="TailSync.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TailSync.Wpf" Title="History">
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ContentControl x:Name="TitleHost" />
        <Grid x:Name="HistoryPage" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Margin="14,12,14,8" Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel>
                    <Grid MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="SearchChrome" Background="{DynamicResource InputBrush}" BorderThickness="1" CornerRadius="9">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></Style.Triggers></Style></Border.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><local:VectorIcon Kind="search" Width="15" Height="15" Margin="9,0,8,0" /><TextBox x:Name="SearchBox" Grid.Column="1" FontFamily="{DynamicResource SearchFont}" FontSize="{DynamicResource SearchFontSize}" BorderThickness="0" Background="Transparent" Padding="0,0,4,0" Tag="搜索历史..." TextChanged="Search_Changed" AutomationProperties.Name="搜索历史" /></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="SyncButton" Style="{StaticResource IconButton}" Width="28" ToolTip="剪贴板同步" Click="Sync_Click" AutomationProperties.Name="剪贴板同步"><Ellipse x:Name="SyncDot" Width="7" Height="7" Fill="{DynamicResource PositiveBrush}" /></Button>
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="Pin_Click" AutomationProperties.Name="窗口置顶"><local:VectorIcon Kind="pin" /></Button>
                            <Button x:Name="FavoritesButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="Favorites_Click" AutomationProperties.Name="打开收藏"><local:VectorIcon Kind="star" /></Button>
                        </StackPanel>
                    </Grid>
                    <Grid MinHeight="30" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryFilter" Style="{StaticResource HistoryFilter}" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="内容分类"><ComboBoxItem Content="全部分类" Tag="all" /><ComboBoxItem Content="文本" Tag="text" /><ComboBoxItem Content="链接" Tag="website" /><ComboBoxItem Content="代码" Tag="code" /><ComboBoxItem Content="路径" Tag="path" /><ComboBoxItem Content="图片" Tag="image" /><ComboBoxItem Content="文件" Tag="file" /></ComboBox>
                        <ComboBox x:Name="DateFilter" Grid.Column="2" Style="{StaticResource HistoryFilter}" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="日期筛选"><ComboBoxItem Content="按日期筛选" Tag="all" /><ComboBoxItem Content="今天" Tag="today" /><ComboBoxItem Content="昨天" Tag="yesterday" /><ComboBoxItem Content="近 7 天" Tag="last7" /><ComboBoxItem Content="近 30 天" Tag="last30" /><ComboBoxItem Content="本月" Tag="thisMonth" /><ComboBoxItem Content="自定义" Tag="custom" /></ComboBox>
                    </Grid>
                    <Grid x:Name="CustomDates" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><DatePicker x:Name="StartDate" SelectedDateChanged="Range_Changed" AutomationProperties.Name="开始日期" /><DatePicker x:Name="EndDate" Grid.Column="2" SelectedDateChanged="Range_Changed" AutomationProperties.Name="结束日期" /></Grid>
                </StackPanel>
            </Border>
            <ListBox x:Name="HistoryList" Grid.Row="1" FocusVisualStyle="{x:Null}" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" local:SmoothScroll.IsEnabled="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="History_DoubleClick" PreviewKeyDown="History_KeyDown" PreviewMouseLeftButtonDown="History_PressStart" PreviewMouseLeftButtonUp="History_PressEnd" PreviewMouseMove="History_PressMove" PreviewMouseRightButtonDown="History_RightButtonDown" PreviewMouseRightButtonUp="History_RightClick" ContextMenuOpening="History_ContextMenuOpening" AutomationProperties.Name="历史记录列表">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HistoryItem}"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DateGroup}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Margin="12,12,12,6" Visibility="{Binding ShowDateGroup, Converter={StaticResource BoolVisibility}}" />
                        <Grid Margin="12,6" Visibility="{Binding ShowBatchHeader, Converter={StaticResource BoolVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BatchSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="{DynamicResource HistoryCopyAll}" Style="{StaticResource PlainButton}" Margin="6,0" Click="RestoreBatch_Click" />
                            <Button Grid.Column="2" Content="{Binding BatchToggleLabel}" Style="{StaticResource PlainButton}" Click="ToggleBatch_Click" Visibility="{Binding ShowBatchToggle, Converter={StaticResource BoolVisibility}}" />
                        </Grid>
                        <Border x:Name="EntryChrome" Padding="12,9" Margin="7,7,0,2" MinHeight="{Binding RowHeight}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource SurfaceRadius}" Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{DynamicResource HistoryRestore}" IsEnabled="{DynamicResource HistoryRestoreAvailable}" local:ButtonDesign.Icon="copy" Click="RestoreRow_Click" /><MenuItem Header="{DynamicResource HistoryPreview}" local:ButtonDesign.Icon="search" Click="PreviewRow_Click" /><MenuItem Header="{DynamicResource HistoryFavorite}" local:ButtonDesign.Icon="star" Click="FavoriteRow_Click" /><MenuItem Header="{DynamicResource HistoryDelete}" local:ButtonDesign.Icon="delete" Click="DeleteRow_Click" /></ContextMenu></Grid.ContextMenu>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Visibility="{Binding HasShortcutNumber, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-19,-16,0,0" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentBrush}" Panel.ZIndex="10" IsHitTestVisible="False">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0.45" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=HistoryList}" Value="True" /><Condition Binding="{Binding DataContext.IsQueryCurrent, ElementName=HistoryList}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="1" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="{Binding ShortcutNumber}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <local:FavoriteFeedback Grid.ColumnSpan="3" Margin="-12,-9" Pinned="{Binding Pinned}" Charge="{Binding FavoriteProgress}" Completion="{Binding FavoriteCompletion}" />
                                <Border x:Name="SelectionMark" Grid.ColumnSpan="3" Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="-12,5,0,5" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Grid Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" UseLayoutRounding="True">
                                    <Border Background="{DynamicResource InputBrush}" CornerRadius="8">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=ThumbnailImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <local:VectorIcon Kind="{Binding Icon}" Width="19" Height="19" Stroke="{DynamicResource SecondaryBrush}" />
                                    </Border>
                                    <local:RoundedThumbnail x:Name="ThumbnailImage" Source="{Binding ThumbnailBytes, Converter={local:HistoryThumbnailConverter}}" CornerRadius="{DynamicResource ControlRadius}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Loaded="Thumbnail_Loaded" DataContextChanged="Thumbnail_ContextChanged" />
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <Grid MinHeight="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AllCategoryLabels}" ToolTip="{Binding AllCategoryLabels}" FontSize="{DynamicResource DetailFontSize}" MaxWidth="130" TextTrimming="CharacterEllipsis" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock x:Name="EntryTime" Grid.Column="1" Text="{Binding Time}" FontSize="{DynamicResource DetailFontSize}" FontWeight="{DynamicResource ThemePanelDefaultFontWeight}" Foreground="{DynamicResource SecondaryBrush}" Margin="9,0,0,0" />
                                        <local:FavoriteFeedback Grid.Column="3" Stamp="True" Width="15" Height="15" Pinned="{Binding Pinned}" Charge="{Binding FavoriteProgress}" Completion="{Binding FavoriteCompletion}" />
                                    </Grid>
                                    <TextBlock x:Name="EntryDescription" Text="{Binding Description}" FontFamily="{DynamicResource HistoryFont}" FontSize="{DynamicResource HistoryFontSize}" FontWeight="{DynamicResource ThemeHistoryDefaultFontWeight}" MinHeight="25" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <Grid MinHeight="22" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="EntrySize" Text="{Binding RowSizeLine}" FontSize="{DynamicResource DetailFontSize}" FontWeight="{DynamicResource ThemePanelDefaultFontWeight}" Foreground="{DynamicResource SecondaryBrush}" />
                                        <TextBlock x:Name="EntrySource" Grid.Column="1" Text="{Binding SourcePeer}" FontSize="{DynamicResource DetailFontSize}" FontWeight="{DynamicResource ThemePanelDefaultFontWeight}" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" MaxWidth="112" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" ToolTip="{Binding SourcePeer}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="22" Click="Info_Click" Visibility="{Binding IsComposite, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="条目详情"><local:VectorIcon Kind="info" Width="13" Height="13" /></Button>
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="22" Click="Format_Click" Visibility="{Binding HasFormatMenu, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="选择复制格式"><local:VectorIcon Kind="more" Width="14" Height="14" /></Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="EntryChrome" Property="Background" Value="{DynamicResource HoverBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="EntryChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" /></DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><Image Source="{DynamicResource ThemeEmptyStateImage}" Width="80" Height="80" Margin="0,0,0,12"><Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></Image.Style></Image><TextBlock x:Name="EmptyTitle" Text="暂无记录" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyDescription" Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Grid.Row="2"><Border x:Name="TransferPanel" Padding="12,6" Visibility="Collapsed"><StackPanel><ProgressBar x:Name="TransferProgress" Height="3" Minimum="0" Maximum="100" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="TransferLabel" FontSize="11" TextTrimming="CharacterEllipsis" /><Button x:Name="StopTransferButton" Grid.Column="1" Content="停止" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Click="StopTransfer_Click" /></Grid></StackPanel></Border><Button local:ButtonDesign.Icon="refresh" x:Name="RetryHistoryButton" Content="加载失败，点击重试" Click="RetryHistory_Click" Margin="12,4" Visibility="Collapsed" /></StackPanel>
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="12,4"><StackPanel><TextBlock x:Name="KeyboardHint" Text="1–6 取用 · ← → 翻页 · F 搜索" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,4" /><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PreviousPageButton" local:ButtonDesign.Icon="back" Style="{StaticResource IconButton}" Width="24" IsEnabled="{Binding HasPrevious}" Click="PreviousPage_Click" AutomationProperties.Name="上一页" /><TextBlock Text="{Binding PageLabel}" FontSize="12" Margin="6,0" /><Button x:Name="NextPageButton" local:ButtonDesign.Icon="chevron" Style="{StaticResource IconButton}" Width="24" IsEnabled="{Binding HasNext}" Click="NextPage_Click" AutomationProperties.Name="下一页" /></StackPanel><Button local:ButtonDesign.Icon="delete" x:Name="ClearButton" DockPanel.Dock="Right" Content="清空所有记录" Style="{StaticResource QuietDestructiveButton}" FontSize="12" Click="Clear_Click" /></DockPanel></StackPanel></Border>
        </Grid>
        <ScrollViewer local:SmoothScroll.IsEnabled="True" x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsContent" Margin="0,14" /></ScrollViewer>
        <ScrollViewer local:SmoothScroll.IsEnabled="True" x:Name="ConnectionsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ConnectionsContent" Margin="0,14" /></ScrollViewer>
        <Border x:Name="Feedback" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="480" Margin="12,0,12,12" Padding="14,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed"><TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="12" /></Border>
    </Grid>
</local:MacWindow>
