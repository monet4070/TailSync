<Window x:Class="TailSync.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TailSync.Native.Core" Title="History">
    <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource CanvasBrush}">
        <Grid.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" /></Grid.KeyboardAccelerators>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid x:Name="TitleBar" Margin="78,0,0,0"><TextBlock x:Name="WindowHeading" Text="History" Margin="6,0,0,0" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center" /></Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="9,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource TrafficLight}" Background="#FF7067" BorderBrush="#E44C45" Click="CloseWindow_Click" AutomationProperties.Name="关闭窗口" />
                <Button Style="{StaticResource TrafficLight}" Background="#FFCD41" BorderBrush="#E7A322" Click="MinimizeWindow_Click" AutomationProperties.Name="最小化窗口" />
                <Button Style="{StaticResource TrafficLight}" Background="#78D54E" BorderBrush="#4CAE24" Click="MaximizeWindow_Click" AutomationProperties.Name="最大化窗口" />
            </StackPanel>
        </Grid>

        <Grid x:Name="HistoryPage" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
            <Border Margin="12,8,12,4" Padding="8" Background="{ThemeResource InputBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0" CornerRadius="10">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource InputBrush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" CornerRadius="7">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource SecondaryBrush}" Margin="9,0,4,0" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索历史..." FontFamily="SimSun" FontSize="18" MinHeight="32" Padding="2,3" CornerRadius="5" Background="Transparent" BorderThickness="0" TextChanged="Search_TextChanged" AutomationProperties.Name="搜索历史" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse x:Name="SyncDot" Fill="{ThemeResource PositiveBrush}" Width="7" Height="7" ToolTipService.ToolTip="同步已开启（演示）" />
                        <ToggleButton x:Name="PinButton" Width="28" Height="28" Click="Pin_Click" Background="Transparent" BorderThickness="0" Padding="3" MinWidth="24" MinHeight="24" AutomationProperties.Name="窗口置顶"><FontIcon Glyph="&#xE718;" FontSize="15" Foreground="{ThemeResource SecondaryBrush}" /></ToggleButton>
                        <Button x:Name="FavoritesButton" Width="28" Height="28" Click="OpenFavorites_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="打开收藏"><FontIcon Glyph="&#xE734;" FontSize="15" /></Button></StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8" Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch" MinHeight="28" Padding="10,1" Background="{ThemeResource InputBrush}" BorderThickness="0" CornerRadius="7" AutomationProperties.Name="内容分类">
                            <ComboBoxItem Content="全部分类" Tag="all" /><ComboBoxItem Content="文本" Tag="text" /><ComboBoxItem Content="链接" Tag="website" /><ComboBoxItem Content="代码" Tag="code" /><ComboBoxItem Content="路径" Tag="path" /><ComboBoxItem Content="图片" Tag="image" /><ComboBoxItem Content="文件" Tag="file" />
                        </ComboBox>
                        <ComboBox x:Name="DateFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch" MinHeight="28" Padding="10,1" Background="{ThemeResource InputBrush}" BorderThickness="0" CornerRadius="7" AutomationProperties.Name="日期筛选">
                            <ComboBoxItem Content="按日期筛选" Tag="all" /><ComboBoxItem Content="今天" Tag="today" /><ComboBoxItem Content="昨天" Tag="yesterday" /><ComboBoxItem Content="近 7 天" Tag="last7" /><ComboBoxItem Content="近 30 天" Tag="last30" /><ComboBoxItem Content="本月" Tag="thisMonth" /><ComboBoxItem Content="自定义" Tag="custom" />
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="CustomDates" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><CalendarDatePicker x:Name="StartDate" Width="155" PlaceholderText="开始" DateChanged="CustomDate_Changed" /><CalendarDatePicker x:Name="EndDate" Width="155" PlaceholderText="结束" DateChanged="CustomDate_Changed" /></StackPanel>
                </StackPanel>
            </Border>
            <ListView x:Name="HistoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries}" SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                ItemContainerStyle="{StaticResource CanvasHistoryItem}" Background="{ThemeResource SurfaceBrush}"
                KeyDown="History_KeyDown" DoubleTapped="History_DoubleTapped" AutomationProperties.Name="历史记录列表">
                <ListView.ItemTemplate><DataTemplate x:DataType="core:HistoryEntry">
                    <Grid Padding="10,8,4,8" MinHeight="{x:Bind RowHeight}" ColumnSpacing="8">
                        <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="回溯" Tag="{x:Bind}" Click="RestoreRow_Click" /><MenuFlyoutItem Text="预览" Tag="{x:Bind}" Click="PreviewRow_Click" /><MenuFlyoutItem Text="收藏 / 取消收藏" Tag="{x:Bind}" Click="FavoriteRow_Click" /><MenuFlyoutItem Text="删除" Tag="{x:Bind}" Click="DeleteRow_Click" /></MenuFlyout></Grid.ContextFlyout>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="9" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"><FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource SecondaryBrush}" /></Border>
                        <Grid Grid.Column="1" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border CornerRadius="7" Background="{ThemeResource AccentSoftBrush}" Padding="4,0"><TextBlock Text="{x:Bind KindLabel}" FontSize="10" Foreground="{ThemeResource AccentBrush}" FontWeight="SemiBold" /></Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{StaticResource Caption}" Margin="6,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind SourcePeer}" FontSize="10" Foreground="{ThemeResource SecondaryBrush}" /><FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource AccentBrush}" Visibility="{x:Bind Pinned, Mode=OneWay}" /></StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontFamily="SimSun" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <Grid Grid.Row="2"><TextBlock Text="{x:Bind RowSizeLine}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3">
                                    <Button Visibility="{x:Bind IsComposite}" Tag="{x:Bind}" Click="Info_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="条目详情"><FontIcon Glyph="&#xE946;" FontSize="13" /></Button>
                                    <Button Visibility="{x:Bind HasFormatMenu}" Style="{StaticResource IconButton}" AutomationProperties.Name="选择复制格式"><FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                        <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="仅复制文字" Tag="{x:Bind}" Click="RestoreRow_Click" /><MenuFlyoutItem Text="仅复制图片" Tag="{x:Bind}" Click="RestoreRow_Click" /></MenuFlyout></Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" VerticalAlignment="Bottom" Height="1" Background="{ThemeResource DividerBrush}" Margin="0,0,0,-10" />
                        </Grid>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="没有找到内容" Foreground="{ThemeResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <Border Grid.Row="2" Background="{ThemeResource SurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerBrush}" Padding="10,0">
                <Grid><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="‹" IsEnabled="False" Style="{StaticResource IconButton}" /><TextBlock Text="1" Style="{StaticResource Caption}" VerticalAlignment="Center" /><Button Content="›" IsEnabled="False" Style="{StaticResource IconButton}" /></StackPanel><Button x:Name="ClearButton" HorizontalAlignment="Right" Content="清空所有记录" Click="Clear_Click" Style="{StaticResource IconButton}" FontSize="11" Foreground="{ThemeResource AccentBrush}" /></Grid>
            </Border>
        </Grid>

        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsContent" Padding="0,14,0,14" Spacing="16" /></ScrollViewer>
        <ScrollViewer x:Name="ConnectionsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ConnectionsContent" Padding="0,14,0,14" /></ScrollViewer>
        <InfoBar x:Name="Feedback" Grid.Row="1" VerticalAlignment="Bottom" IsOpen="False" IsClosable="True" Margin="8,0,8,6" />
    </Grid>
</Window>
