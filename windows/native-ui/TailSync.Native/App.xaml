<Application x:Class="TailSync.Native.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#FAF9F5" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFA" />
                    <SolidColorBrush x:Key="InputBrush" Color="#0B1A1916" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#D5684B" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FD5684B" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#191918" />
                    <SolidColorBrush x:Key="SecondaryBrush" Color="#68665F" />
                    <SolidColorBrush x:Key="TertiaryBrush" Color="#98958B" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#E7E3D9" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#ECE8DF" />
                    <SolidColorBrush x:Key="PositiveBrush" Color="#44745A" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D5684B" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#D5684B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#191918" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#232321" />
                    <SolidColorBrush x:Key="InputBrush" Color="#0EFFFDF5" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#EC8668" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3D2B24" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#F4F1E9" />
                    <SolidColorBrush x:Key="SecondaryBrush" Color="#AAA69C" />
                    <SolidColorBrush x:Key="TertiaryBrush" Color="#8C887D" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#48463F" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#2C2B28" />
                    <SolidColorBrush x:Key="PositiveBrush" Color="#75AA86" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#EC8668" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#EC8668" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#FAF9F5" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFA" />
                    <SolidColorBrush x:Key="InputBrush" Color="#0B1A1916" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#D5684B" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FD5684B" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#191918" />
                    <SolidColorBrush x:Key="SecondaryBrush" Color="#68665F" />
                    <SolidColorBrush x:Key="TertiaryBrush" Color="#98958B" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#E7E3D9" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#ECE8DF" />
                    <SolidColorBrush x:Key="PositiveBrush" Color="#44745A" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D5684B" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#D5684B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="TrafficLight" TargetType="Button">
                <Setter Property="Width" Value="13" /><Setter Property="Height" Value="13" /><Setter Property="MinWidth" Value="13" /><Setter Property="MinHeight" Value="13" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" /></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="MacSwitch" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" /><Setter Property="Height" Value="20" /><Setter Property="MinWidth" Value="44" /><Setter Property="MinHeight" Value="20" /><Setter Property="Padding" Value="0" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="{ThemeResource BorderBrush}" CornerRadius="12" Padding="2">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Unchecked" /><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Track.Background" Value="{ThemeResource AccentBrush}" /><Setter Target="Knob.HorizontalAlignment" Value="Right" /></VisualState.Setters></VisualState><VisualState x:Name="Indeterminate" /></VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Border x:Name="Knob" Background="White" Width="26" Height="16" HorizontalAlignment="Left" CornerRadius="10" />
                </Border></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="SimSun" />
                <Setter Property="FontSize" Value="23" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
                <Setter Property="Margin" Value="16,0,16,6" />
            </Style>
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
            </Style>
            <Style x:Key="CanvasHistoryItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="7,1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="RowContainer" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Background="{ThemeResource SurfaceBrush}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowContainer.Background" Value="{ThemeResource InputBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowContainer.BorderBrush" Value="{ThemeResource AccentBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="RowContainer.BorderBrush" Value="{ThemeResource AccentBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="RowContainer.BorderBrush" Value="{ThemeResource AccentBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="RowContainer.BorderBrush" Value="{ThemeResource AccentBrush}" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
